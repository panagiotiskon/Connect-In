# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Frontend (matches .prettierrc settings)
[*.{js,jsx,ts,tsx,css,scss,json,html,md,yaml,yml}]
indent_style = space
indent_size = 2

# Backend (Java)
[*.java]
indent_style = space
indent_size = 4

[*.xml]
indent_style = space
indent_size = 4
